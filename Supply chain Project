DELIMITER //

-- Ensures we never sell more stock than what's physically in the warehouse
CREATE TRIGGER trg_validate_stock_before_order
BEFORE INSERT ON order_items
FOR EACH ROW
BEGIN
    DECLARE v_current_stock INT;
    DECLARE v_warehouse_id INT;
    
    -- Grab the warehouse ID tied to this order
    SELECT warehouse_id INTO v_warehouse_id 
    FROM orders 
    WHERE order_id = NEW.order_id;
    
    -- Check current stock for the product in that exact warehouse
    SELECT stock_quantity INTO v_current_stock 
    FROM inventory 
    WHERE warehouse_id = v_warehouse_id AND product_id = NEW.product_id;
    
    -- If stock is missing or too low, throw an error and abort
    IF v_current_stock IS NULL OR v_current_stock < NEW.quantity_ordered THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Transaction failed: Insufficient stock available in this warehouse.';
    END IF;
END //

DELIMITER ;

USE scims_db;

DELIMITER //

-- Transaction-safe stored procedure to handle order creation and inventory adjustment atomically
CREATE PROCEDURE sp_place_order(
    IN p_customer_id INT,
    IN p_warehouse_id INT,
    IN p_product_id INT,
    IN p_quantity INT
)
BEGIN
    DECLARE v_order_id INT;
    DECLARE v_unit_price DECIMAL(10,2);
    
    -- Error handling rollback setup
    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        ROLLBACK;
        RESIGNAL;
    END;

    START TRANSACTION;
    
    -- Fetch current product price to lock in historical order pricing
    SELECT unit_price INTO v_unit_price 
    FROM products 
    WHERE product_id = p_product_id;
    
    -- 1. Create order record
    INSERT INTO orders (customer_id, warehouse_id, order_status, total_amount)
    VALUES (p_customer_id, p_warehouse_id, 'Processing', p_quantity * v_unit_price);
    
    SET v_order_id = LAST_INSERT_ID();
    
    -- 2. Insert item line (trigger will evaluate stock level here)
    INSERT INTO order_items (order_id, product_id, quantity_ordered, unit_price)
    VALUES (v_order_id, p_product_id, p_quantity, v_unit_price);
    
    -- 3. Deduct stock from the warehouse inventory
    UPDATE inventory 
    SET stock_quantity = stock_quantity - p_quantity
    WHERE warehouse_id = p_warehouse_id AND product_id = p_product_id;
    
    COMMIT;
END //

DELIMITER ;
USE scims_db;

-- Query 1: Category performance ranking using CTEs and Window Functions
WITH category_performance AS (
    SELECT 
        p.category,
        p.product_name,
        SUM(oi.quantity_ordered * oi.unit_price) AS total_revenue,
        SUM(oi.quantity_ordered) AS units_sold
    FROM products p
    JOIN order_items oi ON p.product_id = oi.product_id
    JOIN orders o ON oi.order_id = o.order_id
    WHERE o.order_status = 'Delivered'
    GROUP BY p.category, p.product_name
)
SELECT 
    category,
    product_name,
    total_revenue,
    units_sold,
    DENSE_RANK() OVER (PARTITION BY category ORDER BY total_revenue DESC) AS revenue_rank
FROM category_performance;


-- Query 2: Low-stock monitoring query to flag items requiring replenishment
SELECT 
    w.warehouse_name,
    p.product_name,
    i.stock_quantity,
    p.reorder_level,
    CASE 
        WHEN i.stock_quantity <= p.reorder_level THEN 'CRITICAL - REORDER'
        ELSE 'Stock Adequate'
    END AS stock_status
FROM inventory i
JOIN warehouses w ON i.warehouse_id = w.warehouse_id
JOIN products p ON i.product_id = p.product_id
WHERE i.stock_quantity <= p.reorder_level;
